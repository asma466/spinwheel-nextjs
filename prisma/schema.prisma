generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
 
 
}

model Employee {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  dob          DateTime @default(now())
  department   String
  createdAt    DateTime  
  // spins        SpinHistory[]
  birthdayRecords BirthdayRecord[]
}

model Gift {
  id        Int      @id @default(autoincrement())
  name      String
  available Boolean  @default(true)
  birthdayRecords  BirthdayRecord[]
}

