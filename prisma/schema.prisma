generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model birthdayrecord {
  id             Int       @id @default(autoincrement())
  year           Int
  emailSent      Boolean   @default(false)
  spinCompleted  Boolean   @default(false)
  employeeId     Int
  giftReceivedId Int?
  giftReceivedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  spinToken      String?   @unique(map: "BirthdayRecord_spinToken_key")
  tokenExpiresAt DateTime?
  autoEmail      Boolean   @default(false)
  emailSentAt    DateTime?
  employee       employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "BirthdayRecord_employeeId_fkey")
  gift           gift?     @relation(fields: [giftReceivedId], references: [id], map: "BirthdayRecord_giftReceivedId_fkey")

 

  @@unique([employeeId, year], map: "BirthdayRecord_employeeId_year_key")
  @@index([giftReceivedId], map: "BirthdayRecord_giftReceivedId_fkey")
}


model employee {
  id                    Int              @id @default(autoincrement())
  name                  String
  email                 String           @unique(map: "Employee_email_key")
  dob                   DateTime         @default(now())
  department            String
  createdAt             DateTime         @default(now())
  role                  employee_role?   @default(USER)
  updatedAt             DateTime         @default(now())
  password              String?
  birthdayEmailSentYear Int?
  birthdayrecord        birthdayrecord[]
}

model gift {
  id             Int              @id @default(autoincrement())
  name           String
  available      Boolean          @default(true)
  createdAt      DateTime         @default(now())
  imageUrl       String?
  quantity       Int              @default(0)
  updatedAt      DateTime         @updatedAt
  birthdayrecord birthdayrecord[]
}

model user {
  id       Int    @id @default(autoincrement())
  email    String @unique(map: "User_email_key")
  password String
  role     String @default("HR")
}

