model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     String @default("HR")
}

model BirthdayRecord {
  id              Int       @id @default(autoincrement())
  year            Int
  emailSent       Boolean   @default(false)
  spinCompleted   Boolean   @default(false)
  autoEmail       Boolean   @default(false)   
   emailSentAt     DateTime?        // 👈 ADD THIS
  // Relations
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  giftReceivedId  Int?
  giftReceived    Gift?     @relation(fields: [giftReceivedId], references: [id])
  spinToken       String?   @unique
  tokenExpiresAt  DateTime?

  giftReceivedAt  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, year]) // One record per employee per year
}