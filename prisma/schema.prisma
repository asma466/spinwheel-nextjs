model ActivityLog {
  id          Int      @id @default(autoincrement())

  userId      String?
  userName    String
  userEmail   String

  action      ActivityAction
  module      ActivityModule

  description String   @db.Text
  changes     Json?                      // Stores field changes as JSON: {fieldName: {before: value, after: value}}

  createdAt   DateTime @default(now())

  @@index([module])
  @@index([action])
  @@index([createdAt])
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  RECEIVED
  LOGIN
  LOGOUT
  EMAIL
  SPIN
}

enum ActivityModule {
  EMPLOYEES
  GIFTS
  BIRTHDAYS
  SETTINGS
  AUTH
}
enum employee_role {
  ADMIN
  USER
}
